# ════════════════════════════════════════════════════════════════════════════
#  NOVA — Configuration
#  Copie ce fichier en .env et remplis les valeurs
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=NOVA
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Mac dev:   DB_HOST=localhost (PostgreSQL local)
# Serveur:   DB_HOST=localhost si PostgreSQL tourne sur le même host Docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jarvis
DB_USER=jarvis
DB_PASSWORD=change_me

# ── Ollama ────────────────────────────────────────────────────────────────────
# Mac dev:   OLLAMA_BASE_URL=http://localhost:11434
# Docker:    OLLAMA_BASE_URL=http://host.docker.internal:11434
#            ou http://100.124.106.27:11434 (Tailscale IP du serveur)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Claude API (pour les tâches complexes — futur) ────────────────────────────
ANTHROPIC_API_KEY=

# ── Remote NOVA server ───────────────────────────────────────────────────────
# URL de l'instance NOVA sur le serveur (Tailscale).
# Fallback TTS si Kokoro n'est pas disponible localement.
# Ex: NOVA_SERVER_URL=http://100.124.106.27:8000
NOVA_SERVER_URL=

# ── Kokoro TTS ────────────────────────────────────────────────────────────────
# Modèles à télécharger: python scripts/download_voices.py  (~400 MB)
KOKORO_MODEL=./kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES=./kokoro/voices-v1.0.bin
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_EN=af_heart
KOKORO_SPEED=1.0

# ── faster-whisper STT ────────────────────────────────────────────────────────
# Modèles: tiny / base / small / medium / large-v3
# Compute: int8 (CPU, rapide) / float32 (CPU, précis) / float16 (GPU seulement)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── ChromaDB (futur — mémoire vectorielle) ────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=nova_memory

# ── nova_listener.py (Phase 3 — wake-word voice mode) ────────────────────────
# URL de l'instance NOVA à appeler (peut être différente de localhost si serveur distant)
NOVA_API_URL=http://localhost:8000
NOVA_API_TIMEOUT=30

# Sensibilité du wake-word (0.0–1.0). Plus élevé = moins de faux positifs.
WAKE_WORD_SENSITIVITY=0.5

# Chemin vers un modèle ONNX "Hey NOVA" personnalisé.
# Laisser vide pour utiliser le modèle intégré (hey_jarvis — placeholder).
# Entraîner un modèle: https://github.com/dscripka/openWakeWord#custom-models
WAKE_WORD_MODEL=

# VAD — détection de fin de parole
LISTENER_SILENCE_THRESHOLD=0.03   # fraction RMS du plein-scale int16 (0.03 ≈ 982/32768)
LISTENER_SILENCE_DURATION=1.5     # secondes de silence consécutif pour arrêter
LISTENER_MAX_DURATION=30          # durée maximale d'un enregistrement (secondes)
