# ════════════════════════════════════════════════════════════════════════════
#  NOVA — Configuration
#  Copie ce fichier en .env et remplis les valeurs
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=NOVA
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Mac dev:   DB_HOST=localhost (PostgreSQL local)
# Serveur:   DB_HOST=localhost si PostgreSQL tourne sur le même host Docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jarvis
DB_USER=jarvis
DB_PASSWORD=jarvis2024

# ── Ollama ────────────────────────────────────────────────────────────────────
# Mac dev:   OLLAMA_BASE_URL=http://localhost:11434
# Docker:    OLLAMA_BASE_URL=http://host.docker.internal:11434
#            ou http://100.124.106.27:11434 (Tailscale IP du serveur)
OLLAMA_BASE_URL=http://100.124.106.27:11434
OLLAMA_MODEL=qwen3:8b

# ── Claude API (pour les tâches complexes — futur) ────────────────────────────
ANTHROPIC_API_KEY=

# ── Piper TTS ─────────────────────────────────────────────────────────────────
# Mac:       brew install piper-tts  → /opt/homebrew/bin/piper
# Linux:     voir scripts/install_piper.sh  → /usr/local/bin/piper
# Docker:    /app/piper/piper
PIPER_BINARY=/opt/homebrew/bin/piper
PIPER_VOICES_DIR=./voices
PIPER_VOICE_FR=fr_FR-siwis-medium
PIPER_VOICE_EN=en_US-lessac-high

# ── Whisper STT ───────────────────────────────────────────────────────────────
# tiny=75MB  base=145MB  small=460MB  medium=1.5GB  large=3GB
WHISPER_MODEL=base

# ── ChromaDB (futur — mémoire vectorielle) ────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=nova_memory
NOVA_SERVER_URL=http://100.124.106.27:8000
